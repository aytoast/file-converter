  "sources": [
    {
      "id": "pdf",
      "label": "PDF 文档",
      "extension": "PDF",
      "sample": "report.pdf",
      "description": "文本 PDF 可重建为可编辑文档，或提取其中的表格与图片。",
      "routes": [
        {
          "target": "docx",
          "label": "Word 文档",
          "dependency": "PyMuPDF / pdf2docx",
          "note": "重建段落和版面。复杂表格、分栏与字体可能变化，需要复核。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "xlsx",
          "label": "Excel 表格",
          "dependency": "PyMuPDF / openpyxl",
          "note": "提取可检测的文字表格；没有表格时明确报告失败。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "png",
          "label": "逐页 PNG 图片",
          "dependency": "PyMuPDF",
          "note": "渲染所有页面，可通过 --pages 选择页码。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "md",
          "label": "Markdown 文字",
          "dependency": "PyMuPDF",
          "note": "提取阅读顺序文字，不自动恢复全部标题与版式。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "images",
          "label": "提取嵌入图片",
          "dependency": "PyMuPDF",
          "note": "提取 PDF 内的原图资源，与整页截图不同。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "pptx",
          "label": "图片型 PowerPoint",
          "dependency": "PyMuPDF / python-pptx",
          "note": "每页封装为图片。输出文字和图形不能直接编辑。",
          "flags": "--allow-layout-loss",
          "status": "ready"
        }
      ],
      "aliases": ""
    },
    {
      "id": "scan",
      "label": "扫描 PDF",
      "extension": "SCAN",
      "sample": "scan.pdf",
      "description": "先进行本地 OCR，再生成文字或叠加可搜索文字层。",
      "routes": [
        {
          "target": "docx",
          "label": "Word 识别文字",
          "dependency": "RapidOCR / python-docx",
          "note": "输出可编辑识别文字，未恢复原始完整排版。",
          "flags": "--ocr",
          "status": "ready"
        },
        {
          "target": "pdf",
          "label": "可搜索 PDF",
          "dependency": "RapidOCR / PyMuPDF",
          "note": "保留原页面外观并叠加隐藏文字。识别内容仍需校对。",
          "flags": "--ocr",
          "status": "ready"
        },
        {
          "target": "xlsx",
          "label": "Excel 识别表格",
          "dependency": "RapidOCR / openpyxl",
          "note": "从文字框位置推断行列，不恢复合并单元格。",
          "flags": "--ocr",
          "status": "ready"
        },
        {
          "target": "txt",
          "label": "纯文字",
          "dependency": "RapidOCR",
          "note": "本地识别印刷文字，复杂版面与手写内容需要额外验收。",
          "flags": "--ocr",
          "status": "ready"
        }
      ],
      "aliases": "ocr 扫描件"
    },
    {
      "id": "docx",
