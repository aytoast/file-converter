    {
      "id": "mp4",
      "label": "视频文件",
      "extension": "MP4",
      "sample": "video.mp4",
      "description": "转码、提取音轨、抽帧与语音识别使用不同路线。",
      "routes": [
        {
          "target": "webm",
          "label": "WebM 视频",
          "dependency": "FFmpeg / VP9 / Opus",
          "note": "默认保留第一条相关音视频轨，额外轨道与元数据不保留。",
          "flags": "--allow-media-loss",
          "status": "ready"
        },
        {
          "target": "mkv",
          "label": "MKV 视频",
          "dependency": "FFmpeg",
          "note": "本路线使用 H.264/AAC 重新编码，不能承诺无损。",
          "flags": "--allow-media-loss",
          "status": "ready"
        },
        {
          "target": "mp3",
          "label": "MP3 音频",
          "dependency": "FFmpeg / LAME",
          "note": "保留第一条音轨；额外音轨和元数据不保留。",
          "flags": "--allow-media-loss",
          "status": "ready"
        },
        {
          "target": "wav",
          "label": "WAV 音频",
          "dependency": "FFmpeg",
          "note": "有损文件转 WAV 不会恢复已经丢失的音质。",
          "flags": "--allow-media-loss",
          "status": "ready"
        },
        {
          "target": "flac",
          "label": "FLAC 音频",
          "dependency": "FFmpeg",
          "note": "无损编码不会恢复源文件此前已经丢失的信息。",
          "flags": "--allow-media-loss",
          "status": "ready"
        },
        {
          "target": "gif",
          "label": "片段 GIF",
          "dependency": "FFmpeg",
          "note": "指定时段与帧率；GIF 无音频，默认宽 480 像素。",
          "flags": "--start 0 --duration 3 --fps 10",
          "status": "ready"
        },
        {
          "target": "frames",
          "label": "PNG 图片序列",
          "dependency": "FFmpeg",
          "note": "按指定时段与帧率抽帧，返回所有图片。",
          "flags": "--start 0 --duration 3 --fps 5",
          "status": "ready"
        },
        {
          "target": "srt",
          "label": "SRT 识别字幕",
          "dependency": "faster-whisper / 本地模型",
          "note": "本地语音识别，需核对专名和时间。中文需要多语言模型。",
          "flags": "--asr-model-path \"C:/models/whisper\" --language zh",
          "status": "ready"
        },
        {
          "target": "docx",
          "label": "Word 识别文字",
          "dependency": "faster-whisper / 本地模型",
          "note": "识别音频中的讲话；不包含说话人分离或翻译。",
          "flags": "--asr-model-path \"C:/models/whisper\" --language zh",
          "status": "ready"
