          "dependency": "Excel 或 LibreOffice",
          "note": "按工作簿打印设置导出，需要检查分页与打印区域。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "json",
          "label": "JSON 数据",
          "dependency": "openpyxl",
          "note": "按工作表导出行数据，需要唯一非空表头。",
          "flags": "--sheet \"Sheet1\"",
          "status": "ready"
        }
      ],
      "aliases": "xls ods 表格"
    },
