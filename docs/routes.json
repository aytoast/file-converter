          "dependency": "python-docx",
          "note": "提取正文和表格文字；图片、脚注与复杂结构不保留。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "images",
          "label": "提取嵌入图片",
          "dependency": "Python / Pillow",
          "note": "提取文档内可读取的图片资源。",
          "flags": "",
          "status": "ready"
        }
      ],
      "aliases": "doc odt rtf"
    },
    {
      "id": "pptx",
      "label": "PowerPoint 演示",
      "extension": "PPTX",
      "sample": "slides.pptx",
      "description": "导出幻灯片页面或提取嵌入图片，编辑能力取决于输出格式。",
      "aliases": "ppt odp 演示 幻灯片",
      "routes": [
        {
          "target": "pdf",
          "label": "PDF 文档",
          "dependency": "PowerPoint 或 LibreOffice",
          "note": "按幻灯片页面导出，需要复核字体、裁剪与复杂对象。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "odp",
          "label": "OpenDocument 演示",
          "dependency": "PowerPoint 或 LibreOffice",
          "note": "转换演示文稿容器，动画与复杂对象可能变化。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "png",
          "label": "逐页 PNG 图片",
          "dependency": "办公引擎 / PyMuPDF",
          "note": "渲染为图片，结果不能直接编辑幻灯片元素。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "images",
          "label": "提取嵌入图片",
          "dependency": "Python / Pillow",
          "note": "提取演示文件内的图片资源，不是整页截图。",
          "flags": "",
          "status": "ready"
        }
      ]
    },
    {
      "id": "csv",
      "label": "CSV 表格",
      "extension": "CSV",
      "sample": "table.csv",
