          "flags": "",
          "status": "ready"
        },
        {
          "target": "odt",
          "label": "OpenDocument 文档",
          "dependency": "Word 或 LibreOffice",
          "note": "转换为 ODT；目标不支持的特性可能变化。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "png",
          "label": "逐页 PNG 图片",
          "dependency": "办公引擎 / PyMuPDF",
          "note": "先导出 PDF 再渲染，保留页面视觉布局。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "md",
