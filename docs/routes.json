        },
        {
          "target": "ods",
          "label": "OpenDocument 表格",
          "dependency": "odfpy",
          "note": "数据交换路线，不保留原本不存在的样式或公式关系。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "json",
          "label": "JSON 数据",
          "dependency": "Python",
          "note": "需要唯一非空表头；每行转换为一个对象。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "tsv",
          "label": "TSV 表格",
          "dependency": "Python",
          "note": "使用制表符分隔，可指定输出编码。",
          "flags": "",
          "status": "ready"
        },
        {
          "target": "geojson",
          "label": "GeoJSON 坐标点",
          "dependency": "GeoPandas / GDAL",
          "note": "需要明确经纬度列与源坐标系，不能猜测。",
          "flags": "--x-column lon --y-column lat --source-crs EPSG:4326",
          "status": "ready"
        }
      ],
      "aliases": "tsv"
    },
    {
      "id": "xlsx",
      "label": "Excel 工作簿",
